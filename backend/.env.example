# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# --- Postgres + pgvector (Neon, hosted) ---
# Paste the connection string exactly as Neon gives it to you -- with or
# without "postgresql+asyncpg://", with or without "?sslmode=require".
# app/db/postgres.py normalizes it for the app's async engine; alembic
# normalizes it separately for migrations. Example shape:
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- Neo4j (Aura, hosted -- dependency / causality graph) ---
# Paste the neo4j+s://... URI Aura gives you exactly as-is.
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# # --- LLM (reasoning model) ---
# # Used by every LangGraph node (Supervisor, Intake, Scope Critic, Planner,
# # GitHub Watcher summarization, Risk Watcher, Reprioritizer, Pitch Agent,
# # Team Assistant). Provider-agnostic: pick ONE provider, set its key and
# # model name, and every node picks it up automatically -- no code changes.
# #
# # Option A - OpenAI:
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL_NAME=gpt-4o
# #
# # Option B - Gemini (comment out the OpenAI block above and use this instead):
# # LLM_PROVIDER=gemini
# # LLM_API_KEY=
# # LLM_MODEL_NAME=gemini-2.0-flash

# # text-embedding-3-small only, kept separate from the reasoning key above --
# # embeddings always go through OpenAI regardless of LLM_PROVIDER. If
# # LLM_PROVIDER=openai you can reuse the same key here.
# OPENAI_API_KEY=

# # --- GitHub integration ---
# # Fernet key used to encrypt github_connections.access_token at rest.
# # Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# GITHUB_TOKEN_ENCRYPTION_KEY=

# Default polling interval for the GitHub watcher, overridable per project.
DEFAULT_POLL_INTERVAL_SECONDS=120

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
